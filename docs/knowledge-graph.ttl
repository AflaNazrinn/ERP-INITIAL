<https://github.com/AflaNazrinn/ERP-INITIAL/resource/commit/2e6b13d> a ge:Commit ;
    rdfs:label "Add Growth Engine dashboard, quick menu and item creation form" ;
    dcterms:date "2026-10-30"^^xsd:date ;
    schema:identifier "2e6b13d" ;
    schema:url <https://github.com/AflaNazrinn/ERP-INITIAL/commit/2e6b13d> .

<https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/hash-router> a ge:Convention ;
    rdfs:label "Hash Router" ;
    rdfs:comment "One page, many screens: a hash router shows one screen; forms live at /new, /<id>, /<id>/edit." .

<https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/keyboard-first> a ge:Convention ;
    rdfs:label "Keyboard First" ;
    rdfs:comment "Keyboard-first: focus stays inside the page; bold letters are shortcuts." .

<https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/money-decimal> a ge:Convention ;
    rdfs:label "Money Decimal" ;
    rdfs:comment "Money is DECIMAL(12,3) handled as strings (OMR baisa precision)." .

<https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/no-build> a ge:Convention ;
    rdfs:label "No Build" ;
    rdfs:comment "No build step: what is in the repo is what runs." .

<https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/server-authority> a ge:Convention ;
    rdfs:label "Server Authority" ;
    rdfs:comment "The server is the authority; browser validation is for instant feedback." .

<https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/strict-csp> a ge:Convention ;
    rdfs:label "Strict Csp" ;
    rdfs:comment "Strict CSP ('self' only): no inline script/style/onclick, no CDNs." .

<https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/text-content> a ge:Convention ;
    rdfs:label "Text Content" ;
    rdfs:comment "Dynamic text is set with textContent, never innerHTML with data." .

