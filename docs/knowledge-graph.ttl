# Knowledge graph of the Growth Engine ERP frontend (ERP-INITIAL), as RDF/Turtle.
# Vocabulary: https://github.com/AflaNazrinn/ERP-INITIAL/ontology#  (ge:)   ·   Things: https://github.com/AflaNazrinn/ERP-INITIAL/resource/  (res:)
# Built from frontend/dashboard.html and dashboard.js at commit 2e6b13d plus project facts.
# Query example (SPARQL): every menu entry with its shortcut and target
#   SELECT ?menu ?entry ?key ?target WHERE {
#     ?m ge:hasEntry ?e . ?m rdfs:label ?menu . ?e rdfs:label ?entry .
#     OPTIONAL { ?e ge:shortcutKey ?key }
#     OPTIONAL { ?e ge:opensMenu|ge:navigatesTo ?t . ?t rdfs:label ?target }
#   }

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ge: <https://github.com/AflaNazrinn/ERP-INITIAL/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix res: <https://github.com/AflaNazrinn/ERP-INITIAL/resource/> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ge:action a owl:DatatypeProperty .

ge:definedIn a owl:ObjectProperty ;
    rdfs:comment "Where this is implemented." ;
    rdfs:range ge:SourceFile .

ge:dependsOn a owl:ObjectProperty ;
    rdfs:comment "Needs this to work." .

ge:fieldName a owl:DatatypeProperty .

ge:follows a owl:ObjectProperty ;
    rdfs:comment "Project follows this convention." ;
    rdfs:domain ge:Project ;
    rdfs:range ge:Convention .

ge:hasCard a owl:ObjectProperty ;
    rdfs:comment "Screen shows this card." ;
    rdfs:domain ge:Screen ;
    rdfs:range ge:DashboardCard .

ge:hasColumn a owl:ObjectProperty ;
    rdfs:comment "Section table has this column." ;
    rdfs:domain ge:FormSection ;
    rdfs:range ge:TableColumn .

ge:hasCommit a owl:ObjectProperty ;
    rdfs:comment "Repository history." ;
    rdfs:domain ge:Project ;
    rdfs:range ge:Commit .

ge:hasEntry a owl:ObjectProperty ;
    rdfs:comment "Menu lists this entry." ;
    rdfs:domain ge:Menu ;
    rdfs:range ge:MenuEntry .

ge:hasField a owl:ObjectProperty ;
    rdfs:comment "Section contains this field." ;
    rdfs:domain ge:FormSection ;
    rdfs:range ge:FormField .

ge:hasFile a owl:ObjectProperty ;
    rdfs:comment "Project contains this file." ;
    rdfs:domain ge:Project ;
    rdfs:range ge:SourceFile .

ge:hasMenu a owl:ObjectProperty ;
    rdfs:comment "Project has this Quick Menu view." ;
    rdfs:domain ge:Project ;
    rdfs:range ge:Menu .

ge:hasScreen a owl:ObjectProperty ;
    rdfs:comment "Project has this screen." ;
    rdfs:domain ge:Project ;
    rdfs:range ge:Screen .

ge:hasSection a owl:ObjectProperty ;
    rdfs:comment "Form page has this section." ;
    rdfs:domain ge:Screen ;
    rdfs:range ge:FormSection .

ge:hasShortcut a owl:ObjectProperty ;
    rdfs:comment "Shortcut available on this screen or menu." ;
    rdfs:range ge:Shortcut .

ge:inputType a owl:DatatypeProperty .

ge:keys a owl:DatatypeProperty .

ge:navigatesTo a owl:ObjectProperty ;
    rdfs:comment "Choosing the entry goes to this route." ;
    rdfs:domain ge:MenuEntry ;
    rdfs:range ge:Route .

ge:opensMenu a owl:ObjectProperty ;
    rdfs:comment "Choosing the entry opens this menu." ;
    rdfs:domain ge:MenuEntry ;
    rdfs:range ge:Menu .

ge:order a owl:DatatypeProperty .

ge:parentMenu a owl:ObjectProperty ;
    rdfs:comment "Esc / back from this menu returns to the parent." ;
    rdfs:domain ge:Menu ;
    rdfs:range ge:Menu .

ge:placeholder a owl:DatatypeProperty .

ge:replacesBrowserAction a owl:DatatypeProperty .

ge:required a owl:DatatypeProperty .

ge:role a owl:DatatypeProperty .

ge:routePath a owl:DatatypeProperty .

ge:scope a owl:DatatypeProperty .

ge:sectionLabel a owl:DatatypeProperty .

ge:shortcutKey a owl:DatatypeProperty .

ge:showsScreen a owl:ObjectProperty ;
    rdfs:comment "The router shows this screen for the route." ;
    rdfs:domain ge:Route ;
    rdfs:range ge:Screen .

ge:status a owl:DatatypeProperty .

ge:usesTechnology a owl:ObjectProperty ;
    rdfs:comment "Project uses this technology." ;
    rdfs:domain ge:Project ;
    rdfs:range ge:Technology .

ge:version a owl:DatatypeProperty .

<https://github.com/AflaNazrinn/ERP-INITIAL/resource/planned/Caddyfile> a ge:PlannedComponent ;
    rdfs:label "Caddyfile" ;
    rdfs:comment "Local HTTPS, routing and security headers." ;
    ge:status "planned" .

<https://github.com/AflaNazrinn/ERP-INITIAL/resource/planned/backend/public/api/session.php> a ge:PlannedComponent ;
    rdfs:label "backend/public/api/session.php" ;
    rdfs:comment "Returns the signed-in user and CSRF token." ;
    ge:status "planned" .

res:project a ge:Project,
        schema:SoftwareSourceCode ;
    rdfs:label "Growth Engine (ERP-INITIAL)" ;
    dcterms:created "2026-10-30"^^xsd:date ;
    rdfs:comment "ERP web application: dashboard, quick menu and master/transaction forms. Currency OMR." ;
    ge:follows <https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/hash-router>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/keyboard-first>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/money-decimal>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/no-build>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/server-authority>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/strict-csp>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/convention/text-content> ;
    ge:hasCommit <https://github.com/AflaNazrinn/ERP-INITIAL/resource/commit/2e6b13d> ;
    ge:hasFile <https://github.com/AflaNazrinn/ERP-INITIAL/resource/file/frontend/dashboard.css>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/file/frontend/dashboard.html>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/file/frontend/dashboard.js>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/file/frontend/fonts/roboto-latin-wght-normal.woff2>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/file/frontend/fonts/roboto-mono-latin-wght-normal.woff2> ;
    ge:hasMenu <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/entry>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/entry-create>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/main>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/masters>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/masters-create>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/purchase-book>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/purchase-book-create>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/returns>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/returns-create>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/supply>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/supply-create>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/trade>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/menu/trade-create> ;
    ge:hasScreen <https://github.com/AflaNazrinn/ERP-INITIAL/resource/screen/dashboard>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/screen/item-creation> ;
    ge:usesTechnology <https://github.com/AflaNazrinn/ERP-INITIAL/resource/tech/caddy>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/tech/composer>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/tech/css>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/tech/html>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/tech/javascript>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/tech/mysql>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/tech/php>,
        <https://github.com/AflaNazrinn/ERP-INITIAL/resource/tech/roboto> ;
    schema:codeRepository <https://github.com/AflaNazrinn/ERP-INITIAL> ;
    schema:currency "OMR" ;
    schema:programmingLanguage "JavaScript",
        "PHP" .

<https://github.com/AflaNazrinn/ERP-INITIAL/resource/route/home> a ge:Route ;
    rdfs:label "#/home" ;
    ge:routePath "#/home" ;
    ge:showsScreen <https://github.com/AflaNazrinn/ERP-INITIAL/resource/screen/dashboard> ;
