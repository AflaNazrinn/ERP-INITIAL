# Copy to backend/.env and fill in. backend/.env is not committed.
APP_ENV=development

# The databases are in companyconfig.php (one per company), not here. When this file still has the
# DB_* lines of an older install, the first companyconfig.php takes its server login from them and keeps
# that database as company MAIN. A new install can leave them out and fill in companyconfig.php instead.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=growth_engine
# DB_USER=growth_engine
# DB_PASS=change-me

# Uploaded documents; must be outside the web roots. Defaults to backend/storage.
# Each company's files are in a folder of their own under it (companies/<CODE>/).
# STORAGE_DIR=/var/lib/growth-engine/storage
